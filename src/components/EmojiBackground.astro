<div class="emoji-bg" aria-hidden="true"></div>

<style>
	.emoji-bg {
		position: fixed;
		inset: 0;
		overflow: hidden;
		pointer-events: none;
		z-index: 0;
	}
	:global(.bg-emoji-fall) {
		position: absolute;
		top: -10vh;
		left: var(--left);
		animation: emoji-fall var(--fall-duration) linear var(--fall-delay) infinite;
	}
	:global(.bg-emoji-spin) {
		display: inline-block;
		font-size: var(--size);
		animation: emoji-spin var(--spin-duration) linear infinite;
		/* 絵文字1つ分だけクリック/タップを受け付ける(背景全体はpointer-events: noneのまま) */
		pointer-events: auto;
		cursor: pointer;
		/* スマホでタップした際に出る灰色のハイライト・長押し選択メニューを抑制 */
		-webkit-tap-highlight-color: transparent;
		-webkit-touch-callout: none;
		user-select: none;
	}
	@keyframes emoji-fall {
		from {
			transform: translateY(0);
		}
		to {
			transform: translateY(120vh);
		}
	}
	@keyframes emoji-spin {
		from {
			transform: rotate(0deg);
		}
		to {
			transform: rotate(calc(var(--spin-dir) * 360deg));
		}
	}
	@media (prefers-reduced-motion: reduce) {
		:global(.bg-emoji-fall),
		:global(.bg-emoji-spin) {
			animation: none;
		}
	}
	:global(.emoji-burst) {
		position: fixed;
		left: 0;
		top: 0;
		width: 0;
		height: 0;
		pointer-events: none;
		z-index: 5;
	}
	:global(.emoji-burst-particle) {
		position: absolute;
		left: 0;
		top: 0;
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 50%;
		background: #f862f9;
		box-shadow: 0 0 6px #f862f9;
		transform: translate(-50%, -50%);
		animation: emoji-burst-particle 500ms ease-out forwards;
	}
	@keyframes emoji-burst-particle {
		from {
			transform: translate(-50%, -50%) scale(1);
			opacity: 1;
		}
		to {
			transform: translate(calc(-50% + var(--bx)), calc(-50% + var(--by))) scale(0.3);
			opacity: 0;
		}
	}
</style>
