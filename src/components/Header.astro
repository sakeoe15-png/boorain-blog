---
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<h2 class="swirl-scope"><a href="/">🧠 {SITE_TITLE}</a></h2>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: var(--color-bg);
		box-shadow: 0 2px 8px rgba(0, 0, 0, 10%);
	}
	h2 {
		margin: 0;
		font-size: 1.2em;
	}
	h2 a {
		text-decoration: none;
		color: var(--color-text);
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
	}
</style>
